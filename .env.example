# ═══════════════════════════════════════════════════════════════════════════
#  Hird Note Backend — Variables d'environnement
#  COPIEZ ce fichier en .env et remplissez vos vraies valeurs
#  ⚠ Ne commitez JAMAIS ce fichier .env sur GitHub !
# ═══════════════════════════════════════════════════════════════════════════

# ── PORT (Render le définit automatiquement) ─────────────────────────────
PORT=3000

# ── BREVO API ────────────────────────────────────────────────────────────
# Récupérez votre clé sur : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=votre_cle_api_brevo_ici

# ── EMAIL EXPÉDITEUR ─────────────────────────────────────────────────────
# Doit être un email vérifié dans votre compte Brevo
SENDER_EMAIL=noreply@votredomaine.com
SENDER_NAME=Hird Note

# ── JWT ──────────────────────────────────────────────────────────────────
# Générez une clé secrète forte :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_cette_valeur_avec_une_cle_aleatoire_de_64_caracteres_minimum
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────────────
# URL de votre frontend Hird Note (ou * pour tout autoriser en dev)
# Exemple : https://maina-xxxx.netlify.app,https://monsite.com
ALLOWED_ORIGINS=*

# ── SÉCURITÉ BATCH RAPPELS ───────────────────────────────────────────────
# Clé pour sécuriser l'endpoint /api/reminders/batch (optionnel)
# Générez une clé : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BATCH_API_KEY=changez_cette_valeur

# ── TWILIO SMS ───────────────────────────────────────────────────────────
# Créez un compte sur https://www.twilio.com (essai gratuit 15 $)
# Africa's Talking pour les numéros africains (RDC, Congo...) :
# https://africastalking.com (alternative recommandée pour l'Afrique)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Votre numéro Twilio (format E.164 : +1234567890)
TWILIO_PHONE_NUMBER=+15005550006
